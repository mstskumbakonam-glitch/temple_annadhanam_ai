# Copy to backend/.env and fill in real values.  NEVER commit .env.
# If the password contains special characters (@ : / # %) URL-encode it in DATABASE_URL.

# ---- Application ----
APP_NAME=Temple Annadhanam AI CCTV
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# Where "today" starts for daily entry/exit totals (IANA name).
SITE_TIMEZONE=Asia/Kolkata

# ---- API security ----
# Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Viewer keys can read the dashboard; admin keys can also change cameras/zones.
# Leave BOTH empty only on a development machine (the API is then open).
# APP_ENV=production refuses to start without API_ADMIN_KEYS.
API_VIEWER_KEYS=
API_ADMIN_KEYS=
# Swagger/ReDoc: default on in development, off in production.
# DOCS_ENABLED=false
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_WRITES_PER_MINUTE=60
# Set to 1 when running behind ONE reverse proxy (nginx, Caddy) that sets X-Forwarded-For.
TRUSTED_PROXY_COUNT=0

# ---- PostgreSQL container (used by docker-compose.yml) ----
POSTGRES_DB=temple_annadhanam
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Application database (must match the values above) ----
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/temple_annadhanam

# Separate database for pytest (tests must use PostgreSQL, never SQLite)
TEST_DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/temple_annadhanam_test

# ---- Connection pool ----
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_ECHO=false

# ---- AI detection / tracking (Phase 5) ----
# No default model: weights are NEVER downloaded automatically.
# Put your YOLO weights somewhere and point to them. Relative paths resolve
# against backend/, e.g. models/yolov8n.pt
AI_MODEL_PATH=
AI_CONFIDENCE=0.4
AI_TRACK_LOW_CONFIDENCE=0.1
AI_IOU=0.5
AI_IMAGE_SIZE=640
AI_DEVICE=cpu
AI_PROCESS_FPS=5
AI_TARGET_CLASSES=person
AI_TRACK_LOST_SECONDS=3
AI_TRACK_MIN_HITS=3
AI_PERSIST_TRACK_EVENTS=true
# Start the camera pipeline together with the API. Run ONE uvicorn worker when true.
AI_AUTOSTART=false
AI_SYNC_INTERVAL=30
# Per-minute people-count history (crowd_count_snapshots) for trend charts.
AI_PERSIST_COUNT_HISTORY=true
# Measured on CPU (docs/EVALUATION.md): crowded wide views need AI_IMAGE_SIZE 960-1280,
# entry/exit lines need >= 5 processed FPS. Override per camera in its analytics config
# ("tuning": {"image_size": 1280, "process_fps": 2, "confidence": 0.3}).

# ---- Demo mode: recorded video through the real pipeline, clearly labelled ----
DEMO_MODE=false
DEMO_VIDEO_DIR=demo_videos

# ---- Annotated preview frames (GET /api/cameras/{id}/preview.jpg) ----
# Off by default. When on, the head area of each person is pixelated unless
# PREVIEW_ANONYMIZE=false. Frames are kept in memory only, never written to disk.
PREVIEW_ENABLED=false
PREVIEW_ANONYMIZE=true
PREVIEW_MAX_WIDTH=960

# ---- Camera capture (RTSP URLs come only from the cameras table) ----
CAMERA_CONNECT_TIMEOUT=10
CAMERA_READ_TIMEOUT=10
CAMERA_RECONNECT_DELAY=2
CAMERA_MAX_RECONNECT_DELAY=60
CAMERA_MAX_CAPTURE_FPS=0
CAMERA_RTSP_TRANSPORT=tcp
CAMERA_HEARTBEAT_SECONDS=30

# ---- Face recognition (registered staff only) ----
FACE_MATCH_THRESHOLD=0.45

# ---- Seat occupancy ----
SEAT_OCCUPANCY_CONFIRM_FRAMES=5
SEAT_EMPTY_CONFIRM_FRAMES=10
SEAT_OCCUPANCY_TIMEOUT=3
